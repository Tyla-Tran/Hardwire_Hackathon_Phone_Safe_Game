#include "Module.h"
#include "SimonSays.h"
#include "Lock.h"
#include "Wires.h"
#include "Maze.h"

Wires wireModule;
Maze mazeModule;
SimonSays simonModule;
Lock lockModule;

//Update if game order is changed
Module* modules[] = { &wireModule, &mazeModule, &simonModule, &lockModule };
int activeIndex = 0;
int no_games = 5;
void loop() {
    modules[activeIndex]->update(); //Calls update on currently active module
    display.clearDisplay(); //Clear Display
    drawTimer(); //Draw a timer
    modules[activeIndex]->render(display); //Render Updated Display
    display.display(); //Display all elements of updated display
    if (modules[activeIndex] -> isSolved()) { //Check private bool solved in each module
        activeIndex++; //Move on to next module
        if (activeIndex < no_games) modules[activeIndex] -> init(); //Initialise the next gmae
        else showWinScreen(); //Else show win screen 
    }
}
